 bool SparseCholeskyWithFallbackSolver::Solve(const Eigen::VectorXd& b,
                                              Eigen::VectorXd* x) const {
   THROW_CHECK_NOTNULL(x);
+#ifndef COLMAP_NO_CHOLMOD
   if (use_ldlt_) {
     x->noalias() = ldlt_.solve(b);
